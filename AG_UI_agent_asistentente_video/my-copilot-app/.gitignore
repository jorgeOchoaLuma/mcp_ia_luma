# Frontend Next.js (my-copilot-app) — copiar como .gitignore

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
/.next/
/out/
/build
.turbo/
.vercel/

# Secrets (permitir .env.example)
.env
.env.*
!.env.example
!.env.local.example

# Credenciales
credentials/
zippy-sublime-*.json
updatezippy-*.json

# Debug / misc
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
*.pem
*.tsbuildinfo
next-env.d.ts

# Testing
/coverage

# Uploads locales
/public/uploads/*
!/public/uploads/.gitkeep
