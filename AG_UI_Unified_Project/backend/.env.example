# Copiar a backend/.env (o exportar en el entorno / Coolify)

# Vertex AI / Gemini (requerido para resumen_reuniones y multimodal)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=tu-proyecto-gcp
GOOGLE_CLOUD_LOCATION=us-central1

# BigQuery analytics del agente (opcional; si faltan, el plugin no se carga)
BQ_DATASET_ID=agente_analytics_db
BQ_LOCATION=us-central1

# Otros agentes del unificado (si usas API key en lugar de Vertex)
# GOOGLE_API_KEY=

# --- NO usadas por resumen_reuniones (solo aparecen en README legacy) ---
# DATASTORE_ID=
# GCS_BUCKET_NAME=
