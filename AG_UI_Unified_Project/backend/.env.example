# Copiar a backend/.env (o variables en Coolify)

# Vertex AI / Gemini (requerido para resumen_reuniones y multimodal)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=zippy-sublime-488620-q2
GOOGLE_CLOUD_LOCATION=global

# BigQuery analytics del agente (opcional; si faltan, el plugin no se carga)
BQ_DATASET_ID=agente_analytics_db
BQ_LOCATION=us-central1

# Bucket para subida de archivos (resumen_reuniones)
GCS_BUCKET_RESUMEN=resumen-reuniones
GCS_BUCKET_NAME=bucket_data1

# Coolify / producción: JSON de service account en base64 (una sola línea)
GOOGLE_APPLICATION_CREDENTIALS_BASE64=

# Local (opcional): ruta al JSON si no usas base64
# GOOGLE_APPLICATION_CREDENTIALS=../credentials/tu-service-account.json

# Otros agentes del unificado (si usas API key en lugar de Vertex)
# GOOGLE_API_KEY=
