# Copiar a backend/.env (o variables en Coolify)

# Vertex AI / Gemini
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=zippy-sublime-488620-q2
GOOGLE_CLOUD_LOCATION=us-central1

# BigQuery analytics (opcional)
BQ_DATASET_ID=agente_analytics_db
BQ_LOCATION=us-central1

# Vertex AI Search — url_expert (RAG web+docs)
DATASTORE_ID=

# Vertex AI Search — soporte (si difiere del anterior)
SOPORTE_DATASTORE_ID=

# Resumen reuniones — GCS upload
GCS_BUCKET_RESUMEN=resumen-reuniones
GCS_BUCKET_NAME=bucket_data1

# Coolify: JSON service account en base64 (una sola línea)
GOOGLE_APPLICATION_CREDENTIALS_BASE64=

# Local (opcional)
# GOOGLE_APPLICATION_CREDENTIALS=../credentials/tu-service-account.json

# No usar junto con Vertex + service account:
# GOOGLE_API_KEY=
# GEMINI_API_KEY=

# Análisis HV / Zoho Recruit
ZOHO_REFRESH_TOKEN=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_SHEET_WORKBOOK_ID=
DOWNLOAD_BASE_PATH=./cvs_descargados
